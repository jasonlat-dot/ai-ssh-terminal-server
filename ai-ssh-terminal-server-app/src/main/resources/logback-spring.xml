<?xml version="1.0" encoding="UTF-8"?>
<!--
日志目录：
默认写入 ./logs（开发模式兼容）。
生产模式由 Tauri 启动器注入 -Dlogging.path=<dataDirectory>/logs，
使日志跟随用户在设置页配置的"统一数据目录"。
-->
<configuration scan="true" scanPeriod="10 seconds">
    <!-- 关闭 logback 自身启动日志 -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <contextName>logback</contextName>
    <property name="spring.output.ansi.enabled" value="ALWAYS"/>

    <!--
    读取 logging.path：
    优先级：JVM -Dlogging.path > yml中的logging.path > 兜底 ./logs
    -->
    <springProperty scope="context" name="LOG_DIR" source="logging.path" defaultValue="./logs"/>

    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex" class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx" class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- 控制台彩色输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yy-MM-dd.HH:mm:ss.SSS}){blue} %clr(%-5p) %clr([%-16t]){cyan} %clr(%-22c{0}){magenta} %clr(%X{ServiceId}){green} %clr(-%X{trace-id}){bright_pink} %clr(%m){purple}%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 启动诊断日志：logback-init.log，排查日志目录问题 -->
    <appender name="INIT_DEBUG" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/logback-init.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="logback.init" level="INFO" additivity="false">
        <appender-ref ref="INIT_DEBUG"/>
    </logger>
    <logger name="logback.configurationWatch" level="INFO" additivity="false">
        <appender-ref ref="INIT_DEBUG"/>
    </logger>

    <!-- INFO文件：保存 INFO、WARN，拒绝ERROR -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/log_info.log</file>
        <encoder>
            <pattern>%d{yy-MM-dd.HH:mm:ss.SSS} [%-16t] %-5p %-22c{0}%X{ServiceId} -%X{trace-id} %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 过滤器：ERROR直接拒绝，其余级别放行 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/log-info-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ERROR文件：只保存ERROR日志 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/log_error.log</file>
        <encoder>
            <pattern>%d{yy-MM-dd.HH:mm:ss.SSS} [%-16t] %-5p %-22c{0}%X{ServiceId} -%X{trace-id} %m%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 过滤器：仅ERROR放行，其余拒绝 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/log-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 异步包装 INFO -->
    <appender name="ASYNC_FILE_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>8192</queueSize>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="INFO_FILE"/>
    </appender>

    <!-- 异步包装 ERROR -->
    <appender name="ASYNC_FILE_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>1024</queueSize>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <springProfile name="dev">
        <logger name="com.nmys.view" level="debug"/>
    </springProfile>

    <root level="info">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE_INFO"/>
        <appender-ref ref="ASYNC_FILE_ERROR"/>
    </root>

</configuration>
