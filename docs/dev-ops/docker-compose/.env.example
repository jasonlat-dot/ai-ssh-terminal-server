# Copy with bash init-env.sh. This file contains no real credentials.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8889
BACKEND_IMAGE_TAG=local
# Set all three before starting. No key is baked into the image.
# Base URL excludes the completions path; e.g. https://api.openai.com/
AI_MODEL_BASE_URL=
AI_MODEL_API_KEY=
AI_MODEL_NAME=
AI_MODEL_COMPLETIONS_PATH=v1/chat/completions
AI_MODEL_EMBEDDINGS_PATH=v1/embeddings
# Generated by init-env.sh. Keep stable; do not replace on updates.
SSH_DEFAULT_SECRET_KEY=
LOCAL_FILE_STORAGE_SIGNING_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Only loopback webpage origins are accepted; [*] allows local ports.
APP_CROSS_ORIGIN=http://127.0.0.1:[*],https://127.0.0.1:[*]
LOCAL_FILE_STORAGE_PUBLIC_BASE_URL=
# Optional JVM flags. Changing them requires up -d, not a new image build.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError
# Optional custom certificate; only used with compose.tls.yaml.
TLS_SERVER_NAME=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_ALIAS=server
