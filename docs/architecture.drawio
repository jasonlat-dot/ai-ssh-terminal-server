<mxfile host="app.diagrams.net" modified="2026-09-24T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="system-overview" name="01-系统总览">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="o-title" value="AI SSH Terminal：两条独立输出链路" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="30" width="820" height="45" as="geometry"/></mxCell>
        <mxCell id="o-browser" value="浏览器 React / xterm.js&#xa;App.tsx · RemoteTerminal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="135" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="o-ssh-controller" value="SSH HTTP 入口&#xa;SshConnectionController&#xa;SshTerminalController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="115" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="o-agent-controller" value="Agent HTTP 入口&#xa;AgentController&#xa;chat_stream / stop_chat / 历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="325" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="o-terminal-service" value="SSH 领域服务&#xa;SshTerminalService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="o-terminal-port" value="基础设施&#xa;TerminalSessionPort&#xa;Reader · Buffer · pendingRead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="105" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="o-remote" value="远端 SSH Shell&#xa;交互式会话 terminalSessionId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1460" y="120" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="o-case" value="Case 执行链&#xa;AIAgentReActServiceCase&#xa;Root → AiCall → ToolCall?&#xa;→ LoopDecision → UserFeedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="320" width="270" height="155" as="geometry"/></mxCell>
        <mxCell id="o-adk" value="Google ADK 1.2.0&#xa;Runner / LlmAgent / Tool&#xa;内部模型 ↔ 工具 ReAct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="330" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="o-llm" value="模型服务&#xa;Spring AI ChatModel&#xa;LocalSpringAI 适配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1460" y="345" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="o-dispatch" value="主 Agent 派发工具&#xa;单子 Agent / 批量 / 规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="545" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="o-child" value="子 Agent Runner&#xa;诊断 / 变更&#xa;executeCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1460" y="545" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="o-events" value="子事件回流&#xa;AgentEventPublisher&#xa;NestedAgentEventForwarder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="590" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="o-context" value="业务上下文 / 历史&#xa;ConversationContextStore · Caffeine&#xa;ChatService / LongTermMemoryService · DB&#xa;CustomAdkSessionService · 本轮 ADK 投影" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="625" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="o-note" value="蓝色：前端　紫色：HTTP/事件边界　绿色：业务逻辑　黄色：运行期/基础设施　红色：外部系统&#xa;终端输出走长轮询；Agent 文本/工具/子 Agent 过程走一个 chat_stream 响应。两条链路共享同一个 SSH Shell，但不是同一个传输协议。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="1510" height="100" as="geometry"/></mxCell>
        <mxCell id="oe1" value="终端 open / read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1" source="o-browser" target="o-ssh-controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe2" value="chat_stream / history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="o-browser" target="o-agent-controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-ssh-controller" target="o-terminal-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-terminal-service" target="o-terminal-port"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-terminal-port" target="o-remote"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-agent-controller" target="o-case"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe7" value="runAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-case" target="o-adk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-adk" target="o-llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-adk" target="o-dispatch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="o-dispatch" target="o-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe11" value="调用 SSH 工具" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="o-child" target="o-terminal-port"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe12" value="发布子事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="o-child" target="o-events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe13" value="写入同一流" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="o-events" target="o-case"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe14" value="加载 / 回写" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;endArrow=block;" edge="1" parent="1" source="o-case" target="o-context"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="terminal-poll" name="02-终端长轮询">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t-title" value="终端：一次输入与一次长轮询的实际路径" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="35" width="880" height="50" as="geometry"/></mxCell>
        <mxCell id="t-open" value="1. 页面连接主机&#xa;connect → terminal/open&#xa;得到 terminalSessionId 和 initialOutput" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="t-poll" value="2. RemoteTerminal.poll()&#xa;同一实例只有一个未完成 read&#xa;GET terminal/read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="385" y="170" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="t-controller" value="3. SshTerminalController&#xa;readAsyncFromTerminal&#xa;返回 CompletableFuture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="710" y="170" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="t-buffer" value="4. TerminalSessionPort.readAsync&#xa;有缓存：立即 DATA&#xa;没缓存：保存 pendingRead future" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1035" y="170" width="275" height="120" as="geometry"/></mxCell>
        <mxCell id="t-reader" value="5. 唯一 SSH Reader 线程&#xa;runOutputReader 阻塞读 Shell&#xa;appendOutput → outputBuffer&#xa;完成 pendingRead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1375" y="155" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="t-write" value="输入方向&#xa;xterm onData / 命令 + CR&#xa;RemoteTerminal.write/exec&#xa;POST terminal/write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="370" y="425" width="275" height="135" as="geometry"/></mxCell>
        <mxCell id="t-shell" value="远端 Shell&#xa;终端会话对应一个交互式通道&#xa;Agent 命令也复用此 Shell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1365" y="440" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="t-result" value="返回 DATA → emit → xterm.write&#xa;TIMEOUT / REPLACED → 立即继续 poll&#xa;DISCONNECTED / READER_ERROR → 停止并提示重连" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="710" y="660" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="t-capture" value="AgentCommandCapture&#xa;从 Reader 收到的相同输出取独立副本&#xa;工具结果与前端终端显示互不抢读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="675" width="350" height="110" as="geometry"/></mxCell>
        <mxCell id="t-timeout" value="25 秒仅表示本次 read 没收到输出；不是 SSH 命令已结束。Agent 工具命令当前上限为 10 秒，属于另一套超时。" style="text;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="835" width="1450" height="55" as="geometry"/></mxCell>
        <mxCell id="te1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-open" target="t-poll"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-poll" target="t-controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-controller" target="t-buffer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te4" value="唤醒 future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="t-reader" target="t-buffer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te5" value="输入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-write" target="t-shell"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te6" value="输出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-shell" target="t-reader"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te7" value="完成 read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t-buffer" target="t-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te8" value="继续 read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="t-result" target="t-poll"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te9" value="独立副本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="t-reader" target="t-capture"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="agent-dispatch" name="03-Agent派发与事件">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="a-title" value="Agent：父 Runner 内部 ReAct、两类子派发及事件回流" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="25" width="970" height="50" as="geometry"/></mxCell>
        <mxCell id="a-request" value="前端 POST chat_stream&#xa;agentId · userId · sessionId&#xa;terminalSessionId · message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="a-case" value="Case 链&#xa;RootNode：加载历史&#xa;AiCallNode：意图、裁剪、Prompt&#xa;准备 ADK Session，runAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="125" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="a-parent" value="父 LlmAgent / ADK Runner&#xa;模型 ↔ 工具循环由 ADK 管理&#xa;主 Agent 不直接执行 SSH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="285" height="125" as="geometry"/></mxCell>
        <mxCell id="a-single" value="直接单子 Agent&#xa;SubAgentDispatchTool&#xa;创建独立 Runner + Session&#xa;流式 doOnNext 发布事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1130" y="105" width="280" height="155" as="geometry"/></mxCell>
        <mxCell id="a-batch" value="批量 / 规划&#xa;BatchSubAgentDispatchTool 或&#xa;DynamicPlanDispatchTool&#xa;解析/校验任务计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1130" y="340" width="280" height="155" as="geometry"/></mxCell>
        <mxCell id="a-orchestrator" value="DynamicAgentOrchestrator&#xa;按 dependsOn 调度 DAG&#xa;maxConcurrency / failFast / SKIPPED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1485" y="345" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="a-service" value="SubAgentDispatchService&#xa;任务状态与重试&#xa;创建子 Runner/Session&#xa;streamingMode = SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1485" y="580" width="270" height="155" as="geometry"/></mxCell>
        <mxCell id="a-child" value="子 Agent&#xa;sshDiagnosisAgent / sshChangeAgent&#xa;持有 executeCommand 工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1130" y="590" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="a-tool" value="SshExecuteAdkTool.runAsync&#xa;安全策略 → SSH Shell&#xa;工具结果回子 Agent，再回父模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1130" y="810" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="a-publisher" value="AgentEventPublisher&#xa;按父业务 sessionId 路由&#xa;携带 agentCallId / toolCallId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="760" y="630" width="285" height="125" as="geometry"/></mxCell>
        <mxCell id="a-forwarder" value="NestedAgentEventForwarder&#xa;agent_start / agent_text / agent_result&#xa;tool_call / tool_result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="625" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="a-stream" value="同一 chat_stream 响应&#xa;主 Agent text → 子过程事件 → 主总结&#xa;ToolCallNode 只归档，不重执行工具&#xa;UserFeedbackNode 发 done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="45" y="610" width="270" height="155" as="geometry"/></mxCell>
        <mxCell id="a-note" value="单子 Agent 与批量/规划是两条不同入口。两条路线都必须把父请求的 terminalSessionId 放入子 ADK Session state；子 Runner 的 sessionId 与父业务 sessionId 不同。" style="text;html=1;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1000" width="1630" height="70" as="geometry"/></mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-request" target="a-case"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae2" value="runAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-case" target="a-parent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae3" value="简单任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-parent" target="a-single"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae4" value="复合任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-parent" target="a-batch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-batch" target="a-orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-orchestrator" target="a-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-service" target="a-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-single" target="a-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="a-child" target="a-tool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae10" value="实时事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="a-child" target="a-publisher"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="a-publisher" target="a-forwarder"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="a-forwarder" target="a-stream"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae13" value="父文本 / done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1" source="a-case" target="a-stream"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="state-cancel" name="04-历史与停止">
    <mxGraphModel dx="1550" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="s-title" value="会话状态的归属，以及“停止”必须穿透的层级" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="30" width="960" height="50" as="geometry"/></mxCell>
        <mxCell id="s-http" value="每次 HTTP 请求&#xa;新的 DynamicContext&#xa;只保留本次计数器、emitter、取消标记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="285" height="120" as="geometry"/></mxCell>
        <mxCell id="s-cache" value="ConversationContextStore / Caffeine&#xa;业务会话快照：历史、任务、里程碑、命令、工具结果&#xa;按 Agent sessionId 跨请求复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="135" width="345" height="145" as="geometry"/></mxCell>
        <mxCell id="s-db" value="chat_session / chat_message&#xa;ChatService 查询历史&#xa;LongTermMemoryService 写入消息&#xa;缓存为空时 RootNode 可回退加载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="135" width="345" height="145" as="geometry"/></mxCell>
        <mxCell id="s-reducer" value="AiCallNode / ChatContextService&#xa;意图识别 → HybridReducer 裁剪&#xa;PromptBuilder 注入业务上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="365" width="345" height="135" as="geometry"/></mxCell>
        <mxCell id="s-adk" value="CustomAdkSessionService&#xa;投影裁剪后的 user / assistant 文本&#xa;附带 terminalSessionId 与取消对象&#xa;本轮 ADK ReAct 所需，不是唯一历史源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="360" width="345" height="150" as="geometry"/></mxCell>
        <mxCell id="s-stop" value="前端停止按钮&#xa;POST /agent/stop_chat&#xa;agentId + userId + sessionId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="s-active" value="AIAgentReActServiceCase&#xa;按业务 sessionId 查 activeStreams&#xa;ReActStreamCancellation 标记并取消 Future" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="650" width="315" height="135" as="geometry"/></mxCell>
        <mxCell id="s-child" value="AgentRunCancellation&#xa;中断主/子 Runner 订阅与任务线程&#xa;规划器不再调度新任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="840" y="650" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="s-command" value="SSH 命令捕获&#xa;被中断时向当前 Shell 发送 Ctrl+C&#xa;前端断开流 ≠ 后端已停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1230" y="650" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="se1" value="加载 / 回写" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="s-http" target="s-cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" value="缓存缺失时回退" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-cache" target="s-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-cache" target="s-reducer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" value="准备本轮调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-reducer" target="s-adk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="s-stop" target="s-active"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="s-active" target="s-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="s-child" target="s-command"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="complete-system" name="05-完整系统架构">
    <mxGraphModel dx="2400" dy="1750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="g0"/><mxCell id="g1" parent="g0"/>
        <mxCell id="g-title" value="AI SSH Terminal · 完整系统架构（读图顺序：左→右，按编号下钻）" style="text;html=1;align=center;fontSize=25;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="300" y="20" width="1570" height="50" as="geometry"/></mxCell>
        <mxCell id="g-head-ui" value="① 浏览器 / React" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="50" y="95" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="g-head-http" value="② Trigger / HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="390" y="95" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="g-head-case" value="③ Case / 请求编排" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="740" y="95" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="g-head-context" value="④ 业务上下文 / 记忆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="1110" y="95" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="g-head-adk" value="⑤ ADK / 工具运行期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="1480" y="95" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="g-head-out" value="⑥ 外部资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="1850" y="95" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="g-ui-connect" value="主机连接管理&#xa;connection/open 获得 terminalSessionId&#xa;连接列表 / 当前主机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="50" y="190" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="g-http-connect" value="SshConnectionController&#xa;创建 SSH 连接和终端会话&#xa;返回 terminalSessionId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="390" y="190" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="g-ui-terminal" value="RemoteTerminal / xterm.js&#xa;write 发送输入；read 长轮询&#xa;DATA 写屏，TIMEOUT 再 poll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="50" y="390" width="290" height="130" as="geometry"/></mxCell>
        <mxCell id="g-http-terminal" value="SshTerminalController&#xa;readAsyncFromTerminal / write&#xa;CompletableFuture 长轮询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="390" y="390" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="g-ui-chat" value="App.tsx / AgentPanel&#xa;发送 agentId、userId、sessionId&#xa;terminalSessionId、message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="50" y="620" width="290" height="130" as="geometry"/></mxCell>
        <mxCell id="g-http-chat" value="AgentController&#xa;chat_stream / stop_chat&#xa;会话列表 / 消息历史 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="390" y="620" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="g-case-entry" value="AIAgentReActServiceCase&#xa;创建 DynamicContext + emitter&#xa;同 session 锁 / activeStreams / 停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="740" y="620" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="g-case-root" value="RootNode&#xa;加载缓存快照；空历史回退 DB&#xa;初始化本次请求 ID / 计数器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="740" y="800" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="g-case-ai" value="AiCallNode&#xa;意图 → 裁剪 → 动态 Prompt&#xa;prepareInvocation → runAsync&#xa;解析文本 / FunctionCall / Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="740" y="980" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="g-case-finish" value="ToolCallNode → LoopDecisionNode&#xa;只核对/归档结果，不补跑命令&#xa;UserFeedbackNode：done + 回写历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="740" y="1190" width="320" height="135" as="geometry"/></mxCell>
        <mxCell id="g-ui-events" value="前端流式事件归并&#xa;text / agent_start / agent_text&#xa;tool_call / tool_result / done&#xa;按 agentCallId、toolCallId 对齐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="50" y="1020" width="290" height="155" as="geometry"/></mxCell>
        <mxCell id="g-http-stream" value="同一个 chat_stream SSE&#xa;父文本 + 子 Agent 过程 + 工具事件&#xa;断连/停止触发取消链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="390" y="1020" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="g-context-store" value="ConversationContextStore（Caffeine）&#xa;按业务 sessionId 跨请求保存&#xa;历史、任务、里程碑、命令、工具结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1110" y="210" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="g-context-db" value="ChatService / LongTermMemoryService&#xa;chat_session、chat_message&#xa;长期记忆与里程碑持久化/恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1110" y="405" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="g-context-intent" value="IntentService / TaskStateVO&#xa;规则 + LLM 分类、反馈重分类&#xa;识别结果仅作 Prompt 提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1110" y="635" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="g-context-reduce" value="ChatContextService / HybridReducer&#xa;压缩长 tool 输出 → 优先级保留&#xa;最近窗口补充 → 整组守预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1110" y="820" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="g-context-prompt" value="MilestoneTracker + ContextProviders&#xa;终端/任务/长期记忆/里程碑/工具摘要&#xa;PromptService → PromptEnvelope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1110" y="1010" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="g-event-forward" value="AgentEventPublisher&#xa;NestedAgentEventForwarder&#xa;按父 sessionId 路由子 Agent 事件&#xa;携带 agentCallId / toolCallId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1110" y="1210" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="g-adk-armory" value="启动装配：Armory / AgentNode&#xa;配置模型、工具、主子 Agent&#xa;Runner / CustomAdkSessionService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1480" y="210" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="g-adk-session" value="CustomAdkSessionService&#xa;本轮投影裁剪后的 user/assistant 文本&#xa;state 带 terminalSessionId / 取消信号&#xa;不是长期历史事实来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1480" y="560" width="320" height="155" as="geometry"/></mxCell>
        <mxCell id="g-adk-parent" value="父 LlmAgent / Google ADK Runner&#xa;内部 LLM ↔ FunctionCall/Response 循环&#xa;主 Agent 选择派发工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1480" y="780" width="320" height="145" as="geometry"/></mxCell>
        <mxCell id="g-adk-child" value="单派发 / 批量 / 动态计划&#xa;SubAgentDispatchService + Orchestrator&#xa;独立子 Runner/Session；子事件回流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1480" y="1000" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="g-adk-tool" value="SshExecuteAdkTool&#xa;CommandSafetyPolicy 先拦截危险命令&#xa;按终端 ID 执行；结果返回子 Runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1480" y="1210" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="g-out-model" value="模型服务 / Spring AI ChatModel&#xa;LocalSpringAI 适配 ADK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1850" y="600" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="g-out-port" value="TerminalSessionPort&#xa;唯一 SSH Reader / outputBuffer&#xa;pendingRead + 命令独立捕获" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1850" y="840" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="g-out-shell" value="远端 SSH Shell&#xa;终端交互与 Agent 命令共用会话&#xa;同一 Shell 命令串行化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1850" y="1110" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="g-out-db" value="数据库&#xa;会话消息 / 长期记忆 / 里程碑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="g1"><mxGeometry x="1850" y="1390" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="ge01" value="连接" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="g1" source="g-ui-connect" target="g-http-connect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge02" value="长轮询 / 输入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="g1" source="g-ui-terminal" target="g-http-terminal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge03" value="chat_stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="g1" source="g-ui-chat" target="g-http-chat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="g1" source="g-http-chat" target="g-case-entry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="g1" source="g-case-entry" target="g-case-root"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="g1" source="g-case-root" target="g-case-ai"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="g1" source="g-case-ai" target="g-case-finish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge08" value="加载 / 回写" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;strokeColor=#82b366;" edge="1" parent="g1" source="g-case-root" target="g-context-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge09" value="冷启动恢复" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#82b366;" edge="1" parent="g1" source="g-context-store" target="g-context-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge10" value="分类" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="g1" source="g-case-ai" target="g-context-intent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge11" value="裁剪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="g1" source="g-case-ai" target="g-context-reduce"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge12" value="富化消息" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="g1" source="g-case-ai" target="g-context-prompt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge13" value="裁剪历史投影" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="g1" source="g-context-reduce" target="g-adk-session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge14" value="runAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="g1" source="g-case-ai" target="g-adk-parent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge15" value="模型调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="g1" source="g-adk-parent" target="g-out-model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge16" value="派发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="g1" source="g-adk-parent" target="g-adk-child"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge17" value="executeCommand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="g1" source="g-adk-child" target="g-adk-tool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge18" value="安全检查后执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="g1" source="g-adk-tool" target="g-out-port"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="g1" source="g-out-port" target="g-out-shell"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge20" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="g1" source="g-http-terminal" target="g-out-port"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge21" value="发布子事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="g1" source="g-adk-child" target="g-event-forward"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge25" value="写入父流" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="g1" source="g-event-forward" target="g-http-stream"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge22" value="父事件 / done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="g1" source="g-case-finish" target="g-http-stream"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge23" value="事件流" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="g1" source="g-http-stream" target="g-ui-events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge24" value="消息 / 记忆" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="g1" source="g-context-db" target="g-out-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g-note" value="状态归属：DynamicContext 只活一次 HTTP；ConversationContextStore 跨请求复用；数据库负责持久化；CustomAdkSessionService 只是本轮裁剪历史的运行期投影。终端长轮询与 Agent SSE 是两条不同的回显通道。" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;" vertex="1" parent="g1"><mxGeometry x="60" y="1580" width="2080" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="context-lifecycle" name="06-上下文裁剪与里程碑">
    <mxGraphModel dx="2450" dy="1850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2450" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="m0"/><mxCell id="m1" parent="m0"/>
        <mxCell id="m-title" value="一次对话的上下文生命周期：读取 → 裁剪 → 里程碑/Provider → Prompt → 回写" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="230" y="20" width="1950" height="50" as="geometry"/></mxCell>
        <mxCell id="m-a" value="A · 请求前历史与混合裁剪（发生在当前 user 消息写入业务历史之前）" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#3f6f46;" vertex="1" parent="m1"><mxGeometry x="55" y="95" width="1800" height="45" as="geometry"/></mxCell>
        <mxCell id="m-root" value="RootNode&#xa;每个 HTTP 新建 DynamicContext&#xa;读业务 sessionId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="55" y="165" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-store" value="ConversationContextStore&#xa;Caffeine：历史 / 任务 / 里程碑&#xa;最近命令 / 工具结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="385" y="165" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-db" value="缓存历史为空时&#xa;LongTermMemoryService 从 DB 恢复&#xa;最近 50 条消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="715" y="165" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-trim" value="AiCallNode 调用&#xa;ChatContextService.trimHistory&#xa;预算 0 → 默认 8000（估算）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1045" y="165" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-compact" value="HybridReducer 第 1 步&#xa;长 tool 输出最多 4000 字符&#xa;保留头尾，尽量保留错误位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1375" y="165" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-priority" value="PriorityReducer&#xa;最近消息组优先 + CRITICAL/HIGH&#xa;再按预算回填、同级取较新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1705" y="165" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-sliding" value="SlidingWindowReducer&#xa;从新到旧选最近完整消息组&#xa;最多 20 组且不超预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="2035" y="165" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-groups" value="原子分组&#xa;assistant.tool_calls + 匹配的 tool 结果&#xa;作为一个组保留或丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1045" y="390" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-merge" value="HybridReducer 第 2 步&#xa;Priority 主集合 + Sliding 补充&#xa;整组复核预算，恢复原时间顺序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1375" y="390" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-projection" value="CustomAdkSessionService&#xa;prepareInvocation 覆盖旧投影&#xa;只投影 user/assistant 文本&#xa;tool 原文不伪装成孤立响应" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1705" y="380" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="m-state" value="ADK Session state&#xa;terminalSessionId / 父 sessionId&#xa;取消对象；本轮 ReAct 协议事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="2035" y="390" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-a-note" value="当前 user 原文在 prepareInvocation 之后 appendUserMessage；模型当前输入由 runAsync(userContent) 单独传入，避免同一条 user 重复。业务历史是跨请求来源，ADK Session 只服务本轮。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="55" y="465" width="900" height="75" as="geometry"/></mxCell>
        <mxCell id="m-b" value="B · 里程碑识别与 Prompt 上下文聚合" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#6f4c80;" vertex="1" parent="m1"><mxGeometry x="55" y="600" width="1400" height="45" as="geometry"/></mxCell>
        <mxCell id="m-user" value="AiCallNode 当前 user 原文&#xa;先保存原文到业务历史&#xa;再调用 detectAndRecordMilestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="55" y="675" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-rule" value="MilestoneTracker&#xa;按 role + YAML 正则匹配&#xa;priority 高优先；只记首个命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="385" y="675" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-types" value="事件类型&#xa;TASK_CHANGE / TASK_COMPLETE&#xa;USER_CORRECTION / ERROR&#xa;内容最多 1024 字符（默认）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="715" y="670" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="m-milestone-save" value="记录与恢复&#xa;ConversationContextStore.addMilestone&#xa;旁路 DB 持久化；缓存空则查 DB&#xa;TASK_CHANGE 可更新当前任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1045" y="665" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="m-context-service" value="ChatContextService&#xa;按 getOrder 收集启用的 Provider&#xa;按 STABLE_PREFIX / EPHEMERAL_SUFFIX 分层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1375" y="675" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="m-prompt-vo" value="PromptContextVO&#xa;稳定：任务、长期记忆&#xa;动态：环境、命令、里程碑&#xa;工具摘要、意图提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1705" y="665" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="m-envelope" value="PromptService / DynamicPromptBuilder&#xa;PromptEnvelope：稳定前缀&#xa;+ 原始用户消息 + 动态尾部&#xa;形成本轮 enrichedMessage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="2035" y="665" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="m-provider-terminal" value="10 TerminalStateProvider&#xa;uname -srm / whoami / pwd&#xa;终端不可用则留空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="55" y="925" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-provider-task" value="20 TaskProvider（稳定）&#xa;TaskStateVO → Store 当前任务&#xa;→ 首条 user 历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="385" y="925" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-provider-memory" value="25 LongTermMemoryProvider（稳定）&#xa;首条 + 最近 user 构造查询&#xa;召回用户长期记忆摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="715" y="925" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-provider-milestone" value="30 MilestoneProvider（动态）&#xa;最近 10 条关键事件（默认）&#xa;缓存优先，缺失时查 DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1045" y="925" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-provider-tool" value="40 ToolResultProvider（动态）&#xa;会话最近工具结果生成摘要&#xa;不把原始输出无限塞入 Prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1375" y="925" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="m-model-input" value="AiCallNode 构造 userContent&#xa;Runner.runAsync + Agent instruction&#xa;由 ADK 组装最终模型请求&#xa;同轮工具结果走 FunctionResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="2035" y="905" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="m-c" value="C · 工具结果、关键事件和业务历史的回写（影响下次 HTTP / 下次 Prompt）" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#8a642c;" vertex="1" parent="m1"><mxGeometry x="55" y="1130" width="1800" height="45" as="geometry"/></mxCell>
        <mxCell id="m-function" value="ADK FunctionCall / FunctionResponse&#xa;同一 invocation 内模型消费工具结果&#xa;AiCallNode 按 toolCallId 记录事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="2035" y="1210" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="m-toolnode" value="ToolCallNode&#xa;按 toolCallId 核对调用与结果&#xa;缺失结果仅合成错误，不重执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1705" y="1210" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="m-tool-milestone" value="工具输出识别里程碑&#xa;role=tool；ERROR 正则匹配&#xa;记录缓存并旁路写 DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1375" y="1210" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="m-tool-summary" value="pushToolResult&#xa;工具名 / args / 输出写 Store&#xa;后续 Provider 才生成摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="1045" y="1210" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="m-feedback" value="UserFeedbackNode&#xa;发 done、关闭 SSE&#xa;finally 回写 history / recentCommands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="715" y="1210" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="m-next" value="下一次 HTTP 请求&#xa;再次 RootNode 加载业务快照&#xa;重复裁剪与动态 Prompt 构建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="m1"><mxGeometry x="385" y="1210" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="m-c-note" value="两条结果路径：① 同一 ADK invocation 中，FunctionResponse 直接返回模型，不等待下一次 HTTP；② ToolCallNode 归档里程碑和工具摘要，影响后续业务 Prompt。数据库消息、长期记忆由 LongTermMemoryService 另行维护。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;" vertex="1" parent="m1"><mxGeometry x="55" y="1460" width="2200" height="75" as="geometry"/></mxCell>
        <mxCell id="m-config" value="默认配置（ai.agent.context）&#xa;Reducer：minimumRecentMessages=5；longAssistantThreshold=4096；maxToolResultCharacters=4000；errorKeywords / importantPathSuffixes 可配置。&#xa;Milestone：enabled=true；recentLimit=10；maxContentLength=1024；规则按 role、priority、pattern 匹配。实际部署值以 YAML 覆盖为准。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=left;" vertex="1" parent="m1"><mxGeometry x="55" y="1580" width="2260" height="140" as="geometry"/></mxCell>
        <mxCell id="me01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-root" target="m-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me02" value="仅缓存历史为空" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-store" target="m-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me30" value="缓存命中，直接裁剪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="m1" source="m-store" target="m-trim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="350"/><mxPoint x="1030" y="350"/></Array></mxGeometry></mxCell>
        <mxCell id="me03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-db" target="m-trim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-trim" target="m-compact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-compact" target="m-priority"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-compact" target="m-sliding"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me07" value="分组规则" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="m1" source="m-groups" target="m-merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-priority" target="m-merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-sliding" target="m-merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-merge" target="m-projection"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="m1" source="m-projection" target="m-state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="m1" source="m-user" target="m-rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="m1" source="m-rule" target="m-types"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="m1" source="m-types" target="m-milestone-save"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me15" value="最近事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" edge="1" parent="m1" source="m-milestone-save" target="m-context-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="m1" source="m-context-service" target="m-prompt-vo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="m1" source="m-prompt-vo" target="m-envelope"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="m1" source="m-envelope" target="m-model-input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="m1" source="m-provider-terminal" target="m-provider-task"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="m1" source="m-provider-task" target="m-provider-memory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="m1" source="m-provider-memory" target="m-provider-milestone"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="m1" source="m-provider-milestone" target="m-provider-tool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me23" value="聚合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="m1" source="m-provider-tool" target="m-context-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="m1" source="m-model-input" target="m-function"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="m1" source="m-function" target="m-toolnode"><mxGeometry relative="1" as="geometry"/></mxCell>
